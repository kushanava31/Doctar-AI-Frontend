# Base URL of the DOCTAR API (backend-node). This frontend and the backend
# are separate, independently deployed projects — there's no shared host,
# so this must point at wherever the backend actually runs.
#
# Local dev (backend running locally via `npm run dev` on its default port):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production: replace with the backend's deployed URL, e.g.
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
